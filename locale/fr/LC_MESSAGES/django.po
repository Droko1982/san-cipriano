msgid "Transporte en brujitas"
msgstr "Transport en brujitas"

msgid "Hoteles y alojamientos comunitarios en armonía con la naturaleza."
msgstr "Hôtels et hébergements communautaires en harmonie avec la nature."

msgid "Gastronomía local preparada por la comunidad con productos frescos."
msgstr ""
"Gastronomie locale préparée par la communauté avec des produits frais."

