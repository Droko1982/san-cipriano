msgstr "Drogues"

msgid "Objetos cortopunzantes"
msgstr "Objets tranchants"

msgid "Turismo Consciente y Respetuoso"
msgstr "Tourisme Conscient et Respectueux"

msgid "Camina solo por los senderos establecidos"
msgstr "Marchez uniquement sur les sentiers établis"

